{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error"
  },
  "overrides": [
    {
      "files": ["apps/api/src/modules/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@nestjs/*", "@prisma/*"],
                "message": "domain/ is pure: no @nestjs/* or @prisma/* imports (Principle VI)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/modules/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../*/repositories/**",
                  "../*/dtos/**",
                  "../*/domain/**",
                  "../../*/repositories/**",
                  "../../*/dtos/**",
                  "../../*/domain/**",
                  "../../../*/repositories/**",
                  "../../../*/dtos/**",
                  "../../../*/domain/**"
                ],
                "message": "modules may only import other modules' services/ (Principle VII)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "jsx-a11y/no-autofocus": "off"
      }
    },
    {
      "files": ["apps/web/src/shared/ui/Picker/**"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "design/**",
    "packages/contract/src/types.ts",
    "apps/web/public/docs/**"
  ]
}
