{
  "name": "api",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.ts",
    "ledger:check": "node src/modules/ledger/reconciliation.ts check",
    "ledger:rebuild": "node src/modules/ledger/reconciliation.ts rebuild",
    "contract:check": "tsc -p tsconfig.build.json && node dist/contract-check.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@types/node": "24.13.6",
    "@types/supertest": "6.0.3",
    "ajv": "8.20.0",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
